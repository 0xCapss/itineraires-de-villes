{
  "name": "itineraires-de-villes",
  "version": "1.0.0",
  "private": true,
  "description": "Itinéraires de villes : préparation de voyages sur des cartes de villes préparées ou générées à la demande",
  "scripts": {
    "build": "python3 build.py",
    "verifier-build": "python3 build.py --check",
    "test": "node --test tests/unitaires/*.test.js && node tests/run.js",
    "test:sans-reseau": "SANS_RESEAU=1 node tests/run.js",
    "test:unitaires": "node --test tests/unitaires/*.test.js",
    "lint": "node tests/lint.js"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright": "^1.50.0"
  }
}
